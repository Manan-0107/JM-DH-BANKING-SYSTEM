# ==============================================================================
# BHARAT TRUST BANK (BTB) - PRODUCTION & EVALUATION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL 8.0+ Database Engine Configuration
# ------------------------------------------------------------------------------
# MySQL 8.0+ is the exclusive runtime database engine for Bharat Trust Bank.
# SQLite runtime adapters and fallback paths are completely removed.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bankist

# Least-Privilege Architecture:
# - During initial DBA provisioning, run database/advanced-sql/09_security_and_roles.sql
# - In production, configure the application to run under dedicated service account 'bankist_app'
#   which is granted 'role_bank_app_service' (DML on banking tables only, strictly NO DDL/SUPER/FILE).
# - For local development / DBA setup, root credentials can be supplied.
DB_USER=bankist_app
DB_PASSWORD=your_secure_database_password_here

# ------------------------------------------------------------------------------
# 2. JWT Cryptographic Authentication Secret
# ------------------------------------------------------------------------------
# In production, configure a high-entropy 256-bit secret (minimum 32 characters).
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit or expose real production secrets.
JWT_SECRET=replace_with_a_secure_random_32_byte_secret_hex_string
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 3. Administrative Authorization
# ------------------------------------------------------------------------------
# Comma-separated list of customer email addresses authorized for administrative metrics
# and audit trail access on the /api/dashboard endpoint.
ADMIN_EMAILS=admin@bharatbank.com,admin@btb.internal

# ------------------------------------------------------------------------------
# 4. AI Banking Copilot (Optional)
# ------------------------------------------------------------------------------
# If provided, enables Google Gemini powered live advisory in Copilot modal.
# If omitted, high-precision deterministic financial heuristics are used.
# All customer identifiers and raw account numbers are masked before external API dispatch.
GEMINI_API_KEY=your_optional_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. Non-Production Security & Evaluation Feature Flags
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), all simulation and demo grant endpoints are
# strictly disabled regardless of these flags, and accounts open with ₹0.00 balance.

# ALLOW_TEST_OTP: If true in development, includes simulated OTP in API responses for automated test suites.
ALLOW_TEST_OTP=false

# ENABLE_DEMO_GRANT: If true in development, provides ₹10,000–₹25,000 welcome grant on account opening.
# Set to false for pristine production accounting (₹0.00 opening balance).
ENABLE_DEMO_GRANT=false
ALLOW_DEMO_GRANT=false

# ALLOW_SIMULATED_UPI: If true in development, allows testing inward UPI credits via /api/upi/simulate-receive.
# In production, returns 403 Forbidden.
ALLOW_SIMULATED_UPI=false
