# ==============================================================================
# BHARAT TRUST BANK (BTB) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Engine Selection
# Set USE_MYSQL=true to connect to MySQL 8.0+.
# If set to false or MySQL connection fails, the system automatically falls back
# to the embedded SQLite database (bankist.sqlite) with identical relational schema.
USE_MYSQL=false

# MySQL 8.0 Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bankist

# JWT Authentication Secret (Must be a secure 32+ character random string in production)
JWT_SECRET=your_secure_32_byte_secret_here_replace_in_production
JWT_EXPIRES_IN=24h

# AI Banking Copilot (Optional)
# If provided, enables Google Gemini powered live advisory in Copilot modal.
# If omitted, high-precision deterministic financial heuristics are used.
GEMINI_API_KEY=
