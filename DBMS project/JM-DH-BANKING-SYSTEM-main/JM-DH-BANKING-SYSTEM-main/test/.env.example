# ==============================================================================
# BHARAT TRUST BANK (BTB) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Engine Selection
# Set USE_MYSQL=true to connect to MySQL 8.0+.
# When USE_MYSQL=true, the system strictly attempts to connect to the MySQL database.
# If the connection fails, startup will abort to prevent silent data divergence.
# Automatic SQLite fallback is permitted ONLY if ALLOW_SQLITE_FALLBACK=true is explicitly
# enabled in development mode (prohibited in production).
# Set USE_MYSQL=false to intentionally use the embedded SQLite database (bankist.sqlite).
USE_MYSQL=false
ALLOW_SQLITE_FALLBACK=false

# MySQL 8.0 Configuration (Used when USE_MYSQL=true)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=bankist

# JWT Authentication Secret
# For production, generate a cryptographically secure 256-bit secret using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   or: openssl rand -hex 32
# Never share or commit production secrets.
JWT_SECRET=your_cryptographically_generated_32_byte_secret_here
JWT_EXPIRES_IN=24h

# AI Banking Copilot (Optional)
# If provided, enables Google Gemini powered live advisory in Copilot modal.
# If omitted, high-precision deterministic financial heuristics are used.
GEMINI_API_KEY=your_gemini_api_key_here

# Security & Demonstration Flags
# In local development and academic evaluation, ALLOW_TEST_OTP=true includes the simulated
# OTP code in the API response for convenient automated testing. In production (NODE_ENV=production),
# test_otp is unconditionally suppressed and prohibited.
ALLOW_TEST_OTP=true

# In local evaluation mode, ENABLE_DEMO_GRANT=true grants a simulated ₹10,000 opening credit
# to new accounts. In production, initial accounts start strictly with ₹0.00 and KYC is 'Pending'.
ENABLE_DEMO_GRANT=true

